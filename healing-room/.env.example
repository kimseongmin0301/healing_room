# .env 파일을 이 형식으로 만들어 주세요. (.env 는 git 에 올라가지 않습니다)

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healing_room
DB_USERNAME=
DB_PASSWORD=

# 관리자 계정: DB 생성 등 수동 작업용. 애플리케이션은 사용하지 않음
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=

# ===== Redis (현재 미사용: 서버를 여러 대로 늘릴 때 사용 예정) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# 사용할 Redis DB 번호 (0~15)
REDIS_DATABASE=1
