# .env 파일을 이 형식으로 만들어 주세요. (.env 는 git 에 올라가지 않습니다)

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healing_room
DB_USERNAME=
DB_PASSWORD=

# 관리자 계정: DB 생성 등 수동 작업용. 애플리케이션은 사용하지 않음
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=

# ===== Redis (채팅) =====
# 이 앱 전용 계정 (~healing-room:* &healing-room:* 권한). README "Redis 전용 계정 만드는 법" 참고
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# 사용할 Redis DB 번호 (0~15)
REDIS_DATABASE=1

# ===== YouTube Data API (곡 추천의 "비슷한 영상") =====
# Google Cloud Console 에서 YouTube Data API v3 를 사용 설정하고 API 키를 발급받아 넣는다. 비워 두면 그 기능만 꺼진다
YOUTUBE_API_KEY=

# ===== 관리자 화면 (/admin) =====
# ① 로그인: 아이디와 비밀번호 해시. 비밀번호(문장 추천)는 원문을 적지 말고 해시만 넣는다
#    해시 만들기: python scripts/admin_password.py  (저장소 루트에서 실행, 출력된 한 줄을 그대로 붙여넣기)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# ② 로그인한 뒤 한 번 더 넣는 관리자 키 (접속자 전체 IP 를 볼 수 있음). 예: openssl rand -hex 24
# 셋 중 하나라도 비어 있으면 관리자 기능이 꺼진다
ADMIN_TOKEN=
